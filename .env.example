# Optional FFmpeg paths. Leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Maximum source upload size in MiB. Default: 2048 (2 GiB).
MAX_UPLOAD_MB=2048

# Optional local-session / token storage secrets. Leave blank for generated development keys.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
