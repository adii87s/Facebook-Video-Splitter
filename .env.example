# Meta Developer App (required only for Facebook publishing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
META_GRAPH_API_VERSION=v26.0

# Optional FFmpeg paths. Leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional maximum source upload size (in MiB). Default: 2048 (2 GiB).
MAX_UPLOAD_MB=2048

# Optional secrets. When omitted, development-only keys are created under data/.
# In production, set long random secrets via environment variables and use a proper secret manager.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
