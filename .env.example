# Optional Meta/Facebook Page publishing credentials. Keep real values in .env only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
META_GRAPH_API_VERSION=v26.0

# Optional FFmpeg paths. Leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Maximum source upload size in MiB. Default: 2048 (2 GiB).
MAX_UPLOAD_MB=2048

# Optional local-session / token storage secrets. Leave blank for generated development keys.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
